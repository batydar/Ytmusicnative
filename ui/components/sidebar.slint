export component Sidebar inherits Rectangle {
    in-out property <int> active-tab: 0;
    in-out property <bool> show-lyrics: true;
    in-out property <bool> show-eq: false;
    in property <string> active-eq-preset: "Flat";
    in property <bool> normalization-enabled: false;
    in property <string> playback-source-badge: "IDLE";
    in property <bool> is-logged-in: false;

    callback tab-selected(int);
    callback toggle-lyrics();
    callback toggle-eq();
    callback open-login-dialog();

    width: 230px;
    background: #110e1c;
    border-width: 1px;
    border-color: #1f1932;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        // Modern App Header
        HorizontalLayout {
            spacing: 12px;
            alignment: start;
            Image {
                width: 36px;
                height: 36px;
                source: @image-url("../icon.png");
                image-fit: contain;
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: "YouTube Music";
                    color: #ffffff;
                    font-size: 15px;
                    font-weight: 700;
                    letter-spacing: 0.3px;
                }
                Text {
                    text: root.is-logged-in ? "HESAP BAĞLI ✓" : "NATIVE DESKTOP";
                    color: root.is-logged-in ? #4ade80 : #c084fc;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                }
            }
        }

        Rectangle {
            height: 6px;
        }

        // Login / Account Action Card
        Rectangle {
            height: 38px;
            border-radius: 8px;
            background: root.is-logged-in ? #1a152e : (login-ta.has-hover ? #9333ea : #7c3aed);
            border-width: 1px;
            border-color: root.is-logged-in ? #a855f755 : #c084fc;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;
                Path {
                    width: 13px;
                    height: 13px;
                    y: 12px;
                    fill: root.is-logged-in ? #4ade80 : #ffffff;
                    commands: "M 6.5 1 A 3 3 0 1 0 6.5 7 A 3 3 0 1 0 6.5 1 Z M 2 12 A 4.5 4.5 0 0 1 11 12 Z";
                }
                Text {
                    text: root.is-logged-in ? "Google Hesabı Aktif ✓" : "Google / QR ile Giriş Yap";
                    color: root.is-logged-in ? #4ade80 : #ffffff;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
            login-ta := TouchArea {
                clicked => {
                    root.open-login-dialog();
                }
            }
        }

        Rectangle {
            height: 4px;
        }

        Text {
            text: "MENU & DISCOVERY";
            color: #756c91;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        // Tab 0: Home Feed
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: root.active-tab == 0 ? #2a1745 : (home-ta.has-hover ? #1c162e : transparent);
            border-width: root.active-tab == 0 ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 12px;
                    fill: root.active-tab == 0 ? #c084fc : (home-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 8 1 L 1 7 L 3 7 L 3 15 L 6 15 L 6 10 L 10 10 L 10 15 L 13 15 L 13 7 L 15 7 Z";
                }
                Text {
                    text: "Home Feed";
                    color: root.active-tab == 0 ? #ffffff : (home-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 13px;
                    font-weight: root.active-tab == 0 ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            home-ta := TouchArea {
                clicked => {
                    root.active-tab = 0;
                    root.tab-selected(0);
                }
            }
        }

        // Tab 1: Search
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: root.active-tab == 1 ? #2a1745 : (search-ta.has-hover ? #1c162e : transparent);
            border-width: root.active-tab == 1 ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 12px;
                    fill: root.active-tab == 1 ? #c084fc : (search-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 6.5 1 A 5.5 5.5 0 1 0 10.4 10.4 L 14.5 14.5 L 15.5 13.5 L 11.4 9.4 A 5.5 5.5 0 0 0 6.5 1 Z M 6.5 2.5 A 4 4 0 1 1 2.5 6.5 A 4 4 0 0 1 6.5 2.5 Z";
                }
                Text {
                    text: "Search";
                    color: root.active-tab == 1 ? #ffffff : (search-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 13px;
                    font-weight: root.active-tab == 1 ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            search-ta := TouchArea {
                clicked => {
                    root.active-tab = 1;
                    root.tab-selected(1);
                }
            }
        }

        // Tab 2: Playlists
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: root.active-tab == 3 ? #2a1745 : (pl-tab-ta.has-hover ? #1c162e : transparent);
            border-width: root.active-tab == 3 ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 12px;
                    fill: root.active-tab == 3 ? #c084fc : (pl-tab-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 1 2 L 15 2 L 15 4 L 1 4 Z M 1 6 L 15 6 L 15 8 L 1 8 Z M 1 10 L 11 10 L 11 12 L 1 12 Z M 1 14 L 8 14 L 8 16 L 1 16 Z";
                }
                Text {
                    text: "Playlists";
                    color: root.active-tab == 3 ? #ffffff : (pl-tab-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 13px;
                    font-weight: root.active-tab == 3 ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            pl-tab-ta := TouchArea {
                clicked => {
                    root.active-tab = 3;
                    root.tab-selected(3);
                }
            }
        }

        // Tab 3: Downloads & Local Cache
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: root.active-tab == 2 ? #2a1745 : (dl-ta.has-hover ? #1c162e : transparent);
            border-width: root.active-tab == 2 ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 12px;
                    fill: root.active-tab == 2 ? #c084fc : (dl-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 7 1 L 9 1 L 9 8 L 12 8 L 8 12 L 4 8 L 7 8 Z M 2 13 L 14 13 L 14 15 L 2 15 Z";
                }
                Text {
                    text: "Downloads";
                    color: root.active-tab == 2 ? #ffffff : (dl-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 13px;
                    font-weight: root.active-tab == 2 ? 700 : 500;
                    vertical-alignment: center;
                }
            }
            dl-ta := TouchArea {
                clicked => {
                    root.active-tab = 2;
                    root.tab-selected(2);
                }
            }
        }

        Rectangle {
            height: 10px;
        }

        Text {
            text: "DSP & LYRICS";
            color: #756c91;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        // Synced Lyrics Toggle Button
        Rectangle {
            height: 38px;
            border-radius: 8px;
            background: root.show-lyrics ? #2a1745 : (lyrics-ta.has-hover ? #1c162e : transparent);
            border-width: root.show-lyrics ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 11px;
                    fill: root.show-lyrics ? #c084fc : (lyrics-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 10 1 L 14 2 L 14 9 A 3 3 0 1 1 11 7 L 11 4 L 7 5 L 7 11 A 3 3 0 1 1 4 9 L 4 3 Z";
                }
                Text {
                    text: "Synced Lyrics";
                    color: root.show-lyrics ? #ffffff : (lyrics-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 12px;
                    font-weight: root.show-lyrics ? 600 : 500;
                    vertical-alignment: center;
                }
            }
            lyrics-ta := TouchArea {
                clicked => {
                    root.toggle-lyrics();
                }
            }
        }

        // Equalizer & DSP Toggle Button
        Rectangle {
            height: 38px;
            border-radius: 8px;
            background: root.show-eq ? #2a1745 : (eq-ta.has-hover ? #1c162e : transparent);
            border-width: root.show-eq ? 1px : 0px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                Path {
                    width: 16px;
                    height: 16px;
                    y: 11px;
                    fill: root.show-eq ? #c084fc : (eq-ta.has-hover ? #ffffff : #9890b0);
                    commands: "M 2 1 L 4 1 L 4 5 L 2 5 Z M 1 5 L 5 5 L 5 7 L 1 7 Z M 2 7 L 4 7 L 4 15 L 2 15 Z M 7 1 L 9 1 L 9 9 L 7 9 Z M 6 9 L 10 9 L 10 11 L 6 11 Z M 7 11 L 9 11 L 9 15 L 7 15 Z M 12 1 L 14 1 L 14 3 L 12 3 Z M 11 3 L 15 3 L 15 5 L 11 5 Z M 12 5 L 14 5 L 14 15 L 12 15 Z";
                }
                Text {
                    text: "Equalizer & DSP";
                    color: root.show-eq ? #ffffff : (eq-ta.has-hover ? #ede9fe : #a7a1bc);
                    font-size: 12px;
                    font-weight: root.show-eq ? 600 : 500;
                    vertical-alignment: center;
                }
            }
            eq-ta := TouchArea {
                clicked => {
                    root.toggle-eq();
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        // Engine Status Footer Card
        Rectangle {
            height: 72px;
            border-radius: 8px;
            background: #171226;
            border-width: 1px;
            border-color: #282040;
            VerticalLayout {
                padding: 10px;
                spacing: 3px;
                HorizontalLayout {
                    spacing: 6px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        y: 4px;
                        border-radius: 3px;
                        background: #a855f7;
                    }
                    Text {
                        text: "MPV PIPE ENGINE";
                        color: #8c82a8;
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                    }
                }
                Text {
                    text: "Preset: " + root.active-eq-preset + (root.normalization-enabled ? " + DynNorm" : "");
                    color: #e2dcf7;
                    font-size: 11px;
                    overflow: elide;
                }
                Text {
                    text: "Source: " + root.playback-source-badge;
                    color: #c084fc;
                    font-size: 11px;
                    font-weight: 600;
                    overflow: elide;
                }
            }
        }
    }
}
