import { ScrollView } from "std-widgets.slint";

export struct UiLyricLine {
    time-label: string,
    text: string,
    active: bool,
}

export component LyricsPanel inherits Rectangle {
    in property <[UiLyricLine]> lines: [];
    in property <string> status-text: "Play a track to load time-synced LRCLIB lyrics.";
    in property <int> active-index: -1;

    width: 300px;
    background: #130f22;
    border-width: 1px;
    border-color: #22193b;

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        HorizontalLayout {
            alignment: space-between;
            Text {
                text: "Synchronized Lyrics";
                color: #ffffff;
                font-size: 15px;
                font-weight: 700;
            }
            Text {
                text: "LRCLIB";
                color: #c084fc;
                font-size: 10px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;

                if root.lines.length == 0 : Rectangle {
                    height: 180px;
                    Text {
                        text: root.status-text;
                        color: #9086a8;
                        font-size: 12px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for line[idx] in root.lines : Rectangle {
                    min-height: 36px;
                    border-radius: 6px;
                    background: line.active ? #2f184e : transparent;
                    border-width: line.active ? 1px : 0px;
                    border-color: #a855f777;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 8px;

                        Text {
                            width: 38px;
                            text: line.time-label;
                            color: line.active ? #c084fc : #7d739c;
                            font-size: 11px;
                            font-weight: line.active ? 700 : 400;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: line.text;
                            color: line.active ? #ffffff : #988eb5;
                            font-size: line.active ? 14px : 12px;
                            font-weight: line.active ? 700 : 400;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
