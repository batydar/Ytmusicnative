import { ScrollView } from "std-widgets.slint";
import { UiTrack } from "home_view.slint";

export struct UiPlaylist {
    browse-id: string,
    title: string,
    subtitle: string,
    track-count: string,
}

export component PlaylistsView inherits Rectangle {
    in property <[UiPlaylist]> playlists: [];
    in property <bool> is-loading: false;
    in property <bool> is-logged-in: false;
    in property <string> active-browse-id: "";
    in property <string> active-playlist-title: "";
    in property <[UiTrack]> active-playlist-tracks: [];
    in property <bool> is-loading-tracks: false;
    in property <string> current-video-id: "";

    callback select-playlist(string, string);
    callback play-track(string);
    callback download-track(string);
    callback refresh-playlists();
    callback open-login();

    background: #0e0b18;

    VerticalLayout {
        padding: 22px;
        spacing: 14px;

        // Top Bar
        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 3px;
                Text {
                    text: root.active-browse-id != "" ? ("Çalma Listesi: " + root.active-playlist-title) : (root.is-logged-in ? "Kaydettiğin ve Oluşturduğun Çalma Listeleri" : "Çalma Listeleri & Koleksiyonlar");
                    color: #ffffff;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: root.active-browse-id != "" ? "Anında dinlemek veya Opus önbelleğine indirmek için bir şarkı seçin" : (root.is-logged-in ? ("Kitaplığınızda " + root.playlists.length + " çalma listesi ve karışım bulundu") : "Kendi kaydettiğiniz ve oluşturduğunuz listeler için giriş yapın");
                    color: #948ba9;
                    font-size: 12px;
                }
            }

            HorizontalLayout {
                spacing: 10px;

                if root.active-browse-id == "" : Rectangle {
                    width: 124px;
                    height: 34px;
                    border-radius: 8px;
                    background: ref-pl-ta.has-hover ? #292045 : #1a142c;
                    border-width: 1px;
                    border-color: #302552;
                    Text {
                        text: root.is-loading ? "Yükleniyor..." : "Listeleri Yenile";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ref-pl-ta := TouchArea {
                        clicked => {
                            root.refresh-playlists();
                        }
                    }
                }

                if root.active-browse-id != "" : Rectangle {
                    width: 120px;
                    height: 34px;
                    border-radius: 8px;
                    background: back-ta.has-hover ? #292045 : #1a142c;
                    border-width: 1px;
                    border-color: #302552;
                    Text {
                        text: "← Listelere Dön";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    back-ta := TouchArea {
                        clicked => {
                            root.select-playlist("", "");
                        }
                    }
                }
            }
        }

        if !root.is-logged-in && root.active-browse-id == "" : Rectangle {
            height: 46px;
            border-radius: 10px;
            background: #23143d;
            border-width: 1px;
            border-color: #a855f755;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;
                Text {
                    text: "Oluşturduğunuz ve kaydettiğiniz tüm çalma listelerini görmek için hesabınıza giriş yapın.";
                    color: #eeddfc;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 165px;
                    height: 30px;
                    y: 8px;
                    border-radius: 6px;
                    background: pl-login-ta.has-hover ? #9333ea : #7c3aed;
                    Text {
                        text: "Google / QR ile Giriş Yap";
                        color: #ffffff;
                        font-size: 11px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    pl-login-ta := TouchArea {
                        clicked => {
                            root.open-login();
                        }
                    }
                }
            }
        }

        // View Mode 1: Playlists Grid / List
        if root.active-browse-id == "" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 8px;
                alignment: start;

                if root.playlists.length == 0 : Rectangle {
                    height: 180px;
                    border-radius: 12px;
                    background: #161126;
                    Text {
                        text: root.is-loading ? "Loading playlists..." : "No playlists loaded. Click Refresh above or login with cookies.";
                        color: #988fae;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for pl in root.playlists : Rectangle {
                    height: 64px;
                    border-radius: 10px;
                    background: pl-ta.has-hover ? #1f1836 : #151024;
                    border-width: 1px;
                    border-color: pl-ta.has-hover ? #a855f766 : #201a35;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;

                        // Playlist Art / Icon Placeholder
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            y: 13px;
                            border-radius: 8px;
                            background: #2c1747;
                            Path {
                                width: 14px;
                                height: 14px;
                                x: 12px;
                                y: 12px;
                                fill: #c084fc;
                                commands: "M 1 2 L 13 2 L 13 4 L 1 4 Z M 1 6 L 13 6 L 13 8 L 1 8 Z M 1 10 L 9 10 L 9 12 L 1 12 Z";
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 3px;
                            Text {
                                text: pl.title;
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: pl.subtitle;
                                color: #9f95ba;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        if pl.track-count != "" : Text {
                            text: pl.track-count;
                            color: #857c9c;
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "→";
                            color: #c084fc;
                            font-size: 14px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }

                    pl-ta := TouchArea {
                        clicked => {
                            root.select-playlist(pl.browse-id, pl.title);
                        }
                    }
                }
            }
        }

        // View Mode 2: Tracks inside the selected Playlist
        if root.active-browse-id != "" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 6px;
                alignment: start;

                if root.active-playlist-tracks.length == 0 : Rectangle {
                    height: 180px;
                    border-radius: 12px;
                    background: #161126;
                    Text {
                        text: root.is-loading-tracks ? "Fetching playlist tracks from YouTube Music..." : "No tracks found in this playlist.";
                        color: #988fae;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                for track in root.active-playlist-tracks : Rectangle {
                    height: 56px;
                    border-radius: 8px;
                    background: track.video-id == root.current-video-id ? #2e1a47 : (track-row-ta.has-hover ? #1e1733 : #151024);
                    border-width: 1px;
                    border-color: track.video-id == root.current-video-id ? #a855f788 : #201a35;

                    track-row-ta := TouchArea {
                        clicked => {
                            root.play-track(track.video-id);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            y: 12px;
                            border-radius: 16px;
                            background: track.video-id == root.current-video-id ? #a855f7 : (track-row-ta.has-hover ? #9333ea : #241c3b);
                            Path {
                                width: 10px;
                                height: 10px;
                                x: 12px;
                                y: 11px;
                                fill: #ffffff;
                                commands: "M 0 0 L 10 5 L 0 10 Z";
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: track.title;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: track.artist;
                                color: #9c92b8;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }

                        if track.is-cached : Rectangle {
                            width: 86px;
                            height: 22px;
                            y: 17px;
                            border-radius: 11px;
                            background: #113020;
                            Text {
                                text: "OPUS CACHED";
                                color: #4ade80;
                                font-size: 9px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            width: 44px;
                            text: track.duration;
                            color: #8c82a8;
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 80px;
                            height: 28px;
                            y: 14px;
                            border-radius: 6px;
                            background: track.is-cached ? #17261d : (pldl-ta.has-hover ? #9333ea : #241c3d);
                            Text {
                                text: track.is-cached ? "✓ Saved" : (track.is-downloading ? Math.round(track.download-progress) + "%" : "Download");
                                color: #ffffff;
                                font-size: 11px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            pldl-ta := TouchArea {
                                enabled: !track.is-cached && !track.is-downloading;
                                clicked => {
                                    root.download-track(track.video-id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
